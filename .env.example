# Local dev: copy this file to .env (same folder) and fill in your values.
# .env is never shared or committed — it's already in .gitignore.
#
# Streamlit Community Cloud: paste the same KEY = "value" pairs (TOML syntax)
# into the app's Secrets panel instead of using this file — they're exposed
# to the deployed app as environment variables the same way.
#
# Shared key (optional): lets users run the app without their own key,
# subject to the per-session call limit below. Keep this cap low for a
# public deployment — it draws from a single funded API key that every
# visitor shares.
SHARED_API_KEY=sk-...
SHARED_KEY_MAX_CALLS=30
SHARED_KEY_MODEL=gpt-4o-mini
SHARED_KEY_URL=https://api.openai.com/v1/chat/completions
